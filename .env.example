# Copy to .env.local for local development, or export these before `docker compose up`.
# Nothing here is required: the defaults run the assessment exactly as delivered.
# There are no secrets in this project.

# Artificial latency, in milliseconds, applied per streamed section so the loading states are
# observable. 0 (the default) is off. Docker: ASSESSMENT_LATENCY_MS=800 docker compose up.
ASSESSMENT_LATENCY_MS=0

# Directory holding subscription_reports.csv and subscription_offers.csv.
# Defaults to <repo>/data/exports, the publisher exports bundled with the assessment.
# Point it at another dataset with the same schema to run the workflow against it.
# ASSESSMENT_EXPORTS_DIR=/absolute/path/to/exports

# Interpreter used for the reconciliation bridge. Defaults to .venv/bin/python when present,
# then `python3`, then `python`. It must be Python 3.11 or newer.
# PYTHON=/usr/bin/python3
