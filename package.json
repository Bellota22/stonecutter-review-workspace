{
  "name": "stonecutter-engineering-assessment",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "node --import tsx main.ts report --brand cedar-coast",
    "report": "node --import tsx main.ts report",
    "query": "node --import tsx main.ts query",
    "reset": "node --import tsx main.ts reset",
    "test": "npm run test:ts && npm run test:python",
    "typecheck": "tsc --noEmit",
    "test:ts": "node --import tsx --test tests/*.test.ts",
    "test:python": "node --import tsx scripts/python.ts test",
    "setup": "node --import tsx scripts/python.ts setup",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm test",
    "demo:ranking": "node --import tsx scripts/ranking-demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "next": "15.5.29",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
